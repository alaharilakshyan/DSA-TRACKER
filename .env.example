# Django Environment Variables Configuration Template
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000

# -------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------
# Local development (default SQLite):
DATABASE_URL=sqlite:///db.sqlite3

# Production (Neon PostgreSQL):
# Format: postgresql://[user]:[password]@[endpoint]/[database]?sslmode=require
# Example with pooling: postgresql://neondb_owner:password@ep-damp-wind-ao48vfnj-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-damp-wind-ao48vfnj.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# -------------------------------------------------------------
# NEON PROJECT METADATA & AUTH (Optional / Reference)
# -------------------------------------------------------------
NEON_PROJECT_ID=withered-rain-91245369
NEON_BRANCH_ID=br-small-band-ao4jkzxd
NEON_AUTH_URL=https://ep-damp-wind-ao48vfnj.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-damp-wind-ao48vfnj.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Neon REST API
NEON_REST_API_URL=https://ep-damp-wind-ao48vfnj.apirest.c-2.ap-southeast-1.aws.neon.tech/neondb/rest/v1

# Neon S3-Compatible Object Storage (Optional for media files)
AWS_ENDPOINT_URL_S3=https://br-small-band-ao4jkzxd.storage.c-2.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=your-neon-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-neon-s3-secret-access-key
AWS_REGION=ap-southeast-1


